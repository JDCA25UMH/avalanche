{tiempo= 72, accion=10,
palabra="ok"}
}
function verificar(palabra)
assert(palabra~=nil, "no puede ser nil")
end
local status, resultado =
 pcall(verificar,nil)
if not status then
palabra = "primero"
end
for i, accion in ipairs(acciones)do
if temporizador>= accion.tiempo then
if accion.tiempo<25 then
tabl2[accion.accion]:down()
end

if accion.tiempo>25 and
accion.tiempo<49 then
tbl3[accion.accion]:down()
end

if accion.tiempo>49 and
accion.tiempo< 73 then
tbl2[accion.accion]:down()
end
palabra = accion.palabra
end

end
cam()
cam("scale",1,1)
print("Mises:",3,4)
print(m,40,4)
print("HIGH SCORE:",80,4)
print(p,140,4)
cam()
print(palabra,150,4)
end

