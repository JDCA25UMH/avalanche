___luacode___
Controls("touch")
cursor("point")
function _init()

end

local Clase = {}
Clase.__index = Clase
function Clase.new(n,x,y)
return setmetatable({num = n,
x=x,y=y},Clase)
end
tabl = {primero,segundo,tercero,
cuarto, quinto,sexto}

for i= 1,6 do
tabl[i]= Clase.new(1,0,30+i*5)
end

local raw04 = {}
raw04.__index = raw04

function raw04.new(num,x,y,aparece,
ocurre,punto,miss)
 local instancia = Clase.new(num,x,y)
 setmetatable(instancia, raw04)
 instancia.aparece = aparece
 instancia.ocurre = ocurre 
 instancia.punto = punto
 instancia.miss = miss
  return instancia
end

tabl2 = {primero_raw04, segundo_raw04,
tercero_raw04, cuarto_raw04,
quinto_raw04,sexto_raw04,septimo_raw04,octavo_raw04,
noveno_raw04,decimo_raw04,once_raw04,
doce_raw04}

for i = 1, 12 do 
tabl2[i]= raw04.new(4,1+(i-1)*5,17,
true,false,false,false)

end

local raw03 = {}
setmetatable(raw03, raw04)

tbl3 ={primero_raw03, segundo_raw03,
tercero_raw03, cuarto_raw03,
quinto_raw03, seis_raw03, siete_raw03,
ocho_raw03, nueve_raw03, diez_raw03,
once_raw03, doce_raw03}

for i = 1, 12 do
tbl3[i]= raw03.new(3,1+(i-1)*5,12,
true,false,false,false)
end
local temporizador = 0 
local indice = 1

ultimo_tiempo = os.time()

raw02 = {}
setmetatable(raw02,raw04)

tbl2 = {
one_raw02, two_raw02,three_raw02,
four_raw02, five_raw02,six_raw02,
seven_raw02,eight_raw02, nine_raw02,
ten_raw02,eleven_raw02,twelve_raw02 }

for i = 1, 12 do
tbl2[i]= raw02.new(2,1+(i-1)*5,7,true,
false,false,false)
end
function _update()

mx,my = getMPos()
function timer()
local tiempo_actual= os.time()

if tiempo_actual-ultimo_tiempo>= 1 then
ultimo_tiempo = tiempo_actual 
temporizador = temporizador +1
end
end

function Clase:move(minX,maxX)
if btnp(2) then
self.x = math.min(self.x +5,maxX)
elseif btnp(1) then
 self.x = math.max(self.x-5,minX)
end
end

tabl[1]:move(0,55)
tabl[2]:move(0,55)
tabl[3]:move(0,55)
tabl[4]:move(0,55)
tabl[5]:move(0,55)

end


function _draw()
timer()
cam()
cam("scale",3,2)
clear()
for i,v in ipairs(tabl)do
Sprite(1,tabl[i].x, tabl[i].y)
end
cam()
cam()
cam("scale",3,2)
for i,v in ipairs(tabl2)do
if tabl2[i].aparece then
Sprite(4,tabl2[i].x, tabl2[i].y)
end
end
cam()
cam()
cam("scale",3,2)
for i,v in ipairs(tbl3) do
if tbl3[i].aparece then 
Sprite(3,tbl3[i].x,tbl3[i].y)
end
end
cam()
cam()
cam("scale",3,2)
for i,v in ipairs(tbl2)do
if tbl2[i].aparece then 
Sprite(2,tbl2[i].x, tbl2[i].y)
end
end
cam()
local m = 0 
local p = 0 

function raw04:down()
if self.y< 33 then
 self.y = self.y +1
end

if tabl[1].x  == self.x -1 then
 self.punto = true
end

if self.y == 33 and self.punto then
self.y = self.y +1
self.aparece = false
self.ocurre = true
end
if self.y == 33 and not self.punto then
self.y = self.y +1
self.miss = true
end
if self.y > 33 and self.punto then
self.y = self.y +1
self.aparece = false
end

if self.y > 33 and not self.punto then
self.y = self.y +1 
self.aparece = true 
end

if self.y >= 127 then
self.y = 127
end
if self.ocurre then 
p = p +1
end
if self.miss then
m = m+1
end
end


local acciones = {
{tiempo = 2, accion =1,
palabra = "cinco"},
